# SylloTrack Environment Variables
# Copy these values into your Vercel Project Environment Variables settings

# MongoDB Connection String (MongoDB Atlas Connection URI)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/syllotrack?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/syllotrack?retryWrites=true&w=majority

# JWT Secret key for authentication tokens
JWT_SECRET=syllotrack_production_secret_key_2026_change_me

# Node Environment
NODE_ENV=production
